<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>1.0.0</Version>
    <Product>Filee Plus</Product>
    <Authors>Beomsuk Kim (LikeU)</Authors>
    <Copyright>Copyright (c) 2026 Beomsuk Kim (LikeU); based on Filee, (c) Myeonggu Kim (KnifeLemon) and Filee contributors</Copyright>

    <!-- Single source of truth for the GitHub repository, the public Filee Plus fork (used by the updater and the About
         page). It must stay public: GitHub shows releases to signed-out apps only then. With no repository the app does
         not check for updates and hides the GitHub links. -->
    <FileeRepositoryUrl>https://github.com/likyu-room/filee-plus</FileeRepositoryUrl>
    <RepositoryUrl>$(FileeRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>
</Project>
