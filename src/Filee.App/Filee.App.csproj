<!--
  Filee.App: the Avalonia desktop application (tray, donut toolbar, settings window).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Bingling</AssemblyName>
    <!-- The file description Task Manager and the start-up list show: tells this app from the original Filee. -->
    <AssemblyTitle>Bingling</AssemblyTitle>
    <RootNamespace>Filee.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\filee.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filee.Core\Filee.Core.csproj" />
    <ProjectReference Include="..\Filee.Engines\Filee.Engines.csproj" />
    <ProjectReference Include="..\Filee.Platform.Windows\Filee.Platform.Windows.csproj" />
    <ProjectReference Include="..\Filee.Platform.Linux\Filee.Platform.Linux.csproj" />
    <ProjectReference Include="..\Filee.Platform.MacOS\Filee.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="SharpHook" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Shown on the About page. -->
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Filee.App.Tests" />
  </ItemGroup>

  <!-- Repository URL for the updater / About page, taken from Directory.Build.props. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryUrl</_Parameter1>
      <_Parameter2>$(FileeRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
    <!-- Published builds (installer, portable zip) set -p:FileeRelease=true: only they register Explorer and startup
         entries (UpdateService.IsReleaseBuild), so running from source leaves the user's system alone. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(FileeRelease)' == 'true'">
      <_Parameter1>FileeRelease</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
