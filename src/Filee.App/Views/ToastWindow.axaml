<!-- Progress cards in the bottom-right corner. Shows itself while ToastJobs is non-empty, hides when empty. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Filee.Core"
        xmlns:vm="using:Filee.App.ViewModels"
        xmlns:s="using:Filee.App.Services"
        xmlns:v="using:Filee.App.Views"
        x:Class="Filee.App.Views.ToastWindow"
        x:DataType="s:ConversionService"
        Title="{x:Static core:AppIdentity.Name}"
        Width="360"
        SizeToContent="Height"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
  <Window.Styles>
    <Style Selector="ItemsControl#Jobs ContentPresenter">
      <Style.Animations>
        <Animation Duration="0:0:0.35" Easing="BackEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Margin" Value="40,0,-40,0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Margin" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.reduced-motion ItemsControl#Jobs ContentPresenter">
      <Style.Animations>
        <Animation Duration="0:0:0.001" FillMode="Forward">
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- The thumbnail button: the picture itself, without a button's own surface. -->
    <Style Selector="Button.thumbnail">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <!-- The theme greys a button's surface on hover and press; the picture needs none. -->
    <Style Selector="Button.thumbnail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.thumbnail:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.thumbnail Border.open-mark">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.thumbnail:pointerover Border.open-mark">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Height" Value="6" />
    </Style>
  </Window.Styles>

  <ItemsControl x:Name="Jobs" ItemsSource="{Binding ToastJobs}" Margin="12">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Spacing="8" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:JobViewModel">
        <Border Classes="card" Padding="14,12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <!-- What came out: a rounded picture of it, or (no picture to show) a circle with the icon of its format. -->
            <Panel Grid.Column="0" Width="56" Height="56" VerticalAlignment="Top">
              <Border Classes="format-circle" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}"
                      IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                <PathIcon Width="24" Height="24" Data="{Binding FormatIcon}" />
              </Border>
              <!-- The picture is a button: a press opens the result in the app the system has for it. While the pointer is on
                   it a dark veil with the open mark says so (the hand cursor and the tip say it too). -->
              <Button Classes="ghost thumbnail" Command="{Binding OpenResultCommand}"
                      ToolTip.Tip="{DynamicResource toast.open_result}" AutomationProperties.Name="{DynamicResource toast.open_result}"
                      IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Panel>
                  <Border CornerRadius="12" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  </Border>
                  <Border Classes="open-mark" CornerRadius="12" Background="#66000000" IsHitTestVisible="False">
                    <PathIcon Width="20" Height="20" Data="{StaticResource Icon.OpenInNew}" Foreground="White" />
                  </Border>
                </Panel>
              </Button>
            </Panel>
            <StackPanel Grid.Column="1" Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding DismissCommand}" Padding="4" VerticalAlignment="Top">
                  <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" />
                </Button>
                <!-- The check wears the success colour; its glyph is picked to read on it in light and dark. -->
                <Border DockPanel.Dock="Right" Classes="success-badge" Width="18" Height="18" CornerRadius="9" Margin="6,0"
                        VerticalAlignment="Center" Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsSucceeded}">
                  <PathIcon Width="10" Height="10" Data="{StaticResource Icon.Check}"
                            Foreground="{Binding $parent[Border].Background, Converter={x:Static v:BadgeGlyphConverter.Instance}}" />
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Classes="caption" Text="{Binding SizeChange}" TextWrapping="Wrap"
                         IsVisible="{Binding SizeChange, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsRunning}" />
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                  <Button Content="{DynamicResource toast.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" Padding="10,4" />
                  <Button Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
                      <TextBlock Text="{DynamicResource common.retry}" />
                    </StackPanel>
                  </Button>
                  <!-- Only for a card with a picture (the thumbnail): the picture goes on the clipboard, several results as files.
                       The label turns to "Copied" for a moment; the click is handled in ToastWindow.axaml.cs, which has the clipboard. -->
                  <Button Classes="copy" Click="OnCopyResult" Padding="10,4" ToolTip.Tip="{DynamicResource toast.copy_tip}"
                          IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Panel>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !JustCopied}">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Copy}" />
                        <TextBlock Text="{DynamicResource toast.copy}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding JustCopied}">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Check}" />
                        <TextBlock Text="{DynamicResource toast.copied}" />
                      </StackPanel>
                    </Panel>
                  </Button>
                  <Button Classes="accent" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasOutputs}" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Folder}" />
                      <TextBlock Text="{DynamicResource toast.open_folder}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding Status}" IsVisible="{Binding ShowsStatus}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Classes="caption danger" Text="{Binding ErrorDetails}" TextWrapping="Wrap" MaxLines="4"
                         IsVisible="{Binding HasErrors}" />
              <TextBlock Classes="caption" Text="{Binding Notices}" TextWrapping="Wrap" MaxLines="4"
                         IsVisible="{Binding HasNotices}" />
              <!-- Files of a type Filee doesn't know: open the GitHub "Format request" form (FormatRequest). The form lives
                   in the repository, so the button is gone while the fork has none. -->
              <StackPanel IsVisible="{x:Static s:UpdateService.HasRepository}">
                <Button HorizontalAlignment="Left" Padding="10,4" Click="OnRequestFormat"
                        IsVisible="{Binding CanRequestFormat}" Content="{DynamicResource format_request.request}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</Window>
