<!-- The image tool window (crop so far), opened from the donut's tools: the tool and file with "1 of 3" and ‹ › on top,
     the picture with the box in the middle, the tool's panel on the right, and Reset / Cancel / Save below. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        xmlns:c="using:Filee.App.Controls"
        x:Class="Filee.App.Views.ImageToolWindow"
        x:DataType="vm:ImageToolViewModel"
        Title="{Binding Title}"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="960" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- ‹ on the first file and › on the last: just dimmer, not a grey box. -->
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubtleBorderBrush}"
            Background="{DynamicResource SurfaceBrush}">
      <DockPanel>
        <!-- Not focusable: the keyboard stays with the picture (Enter saves, ← / → change the file). -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasMany}">
          <TextBlock Classes="muted" Text="{Binding PositionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Classes="icon" Focusable="False" Command="{Binding PreviousCommand}">
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.ChevronRight}" RenderTransform="rotate(180deg)" />
          </Button>
          <Button Classes="icon" Focusable="False" Command="{Binding NextCommand}">
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.ChevronRight}" />
          </Button>
        </StackPanel>
        <TextBlock Classes="h2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MinHeight="32" Padding="0,5,0,0" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}"
            Background="{DynamicResource SurfaceBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource tool.reset}" Command="{Binding ResetCommand}" Focusable="False" />
          <Button Content="{DynamicResource tool.cancel}" Command="{Binding CancelCommand}" />
          <Button Classes="accent" Content="{DynamicResource tool.save}" Command="{Binding SaveCommand}" />
        </StackPanel>
        <TextBlock Classes="caption" Text="{Binding FooterText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <!-- The tool's own settings; its width is ImageToolWindow.PanelWidth. -->
    <Border DockPanel.Dock="Right" Width="260" Padding="18,16" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}"
            Background="{DynamicResource SurfaceBrush}">
      <ContentControl x:Name="ToolPanel" />
    </Border>

    <c:ImageCanvas x:Name="Picture" Source="{Binding Preview}" Crop="{Binding Crop}" />
  </DockPanel>
</Window>
