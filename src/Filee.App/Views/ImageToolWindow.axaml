<!-- The image tool window, opened from the donut's tools: the tool and file with "1 of 3" and ‹ › on top,
     the tool's picture view in the middle, its panel on the right, and Reset / Cancel / Copy / Save below. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.ImageToolWindow"
        x:DataType="vm:ImageToolViewModel"
        Classes="glassy"
        Title="{Binding Title}"
        Icon="avares://Bingling/Assets/Icons/filee.ico"
        Width="960" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- ‹ on the first file and › on the last: just dimmer, not a grey box. -->
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubtleBorderBrush}"
            Classes="bar">
      <DockPanel>
        <!-- Not focusable: the keyboard stays with the picture (Enter saves, ← / → change the file). -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
          <!-- Undo, redo and fit are always there (also for one file): a wrong drawing or a Reset could otherwise be put back
               only with keys the window never mentions. A press here ends what the picture is in the middle of, as a text
               half typed, so the undo takes that text and not the drawing before it (ImageToolWindow.axaml.cs). -->
          <StackPanel x:Name="HistoryButtons" Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" Focusable="False" Command="{Binding UndoCommand}" ToolTip.Tip="{DynamicResource tool.undo}"
                    AutomationProperties.Name="{DynamicResource tool.undo}">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Undo}" />
            </Button>
            <Button Classes="icon" Focusable="False" Command="{Binding RedoCommand}" ToolTip.Tip="{DynamicResource tool.redo}"
                    AutomationProperties.Name="{DynamicResource tool.redo}">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Redo}" />
            </Button>
            <Button Classes="icon" Focusable="False" Click="OnFit" ToolTip.Tip="{DynamicResource tool.fit}"
                    AutomationProperties.Name="{DynamicResource tool.fit}">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.FitToScreen}" />
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasMany}">
            <Border Width="1" Height="16" Margin="8,0,10,0" Background="{DynamicResource SubtleBorderBrush}" />
            <TextBlock Classes="muted" Text="{Binding PositionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Classes="icon" Focusable="False" Command="{Binding PreviousCommand}" ToolTip.Tip="{DynamicResource tool.previous}"
                    AutomationProperties.Name="{DynamicResource tool.previous}">
              <PathIcon Width="12" Height="12" Data="{StaticResource Icon.ChevronRight}" RenderTransform="rotate(180deg)" />
            </Button>
            <Button Classes="icon" Focusable="False" Command="{Binding NextCommand}" ToolTip.Tip="{DynamicResource tool.next}"
                    AutomationProperties.Name="{DynamicResource tool.next}">
              <PathIcon Width="12" Height="12" Data="{StaticResource Icon.ChevronRight}" />
            </Button>
          </StackPanel>
        </StackPanel>
        <TextBlock Classes="h2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MinHeight="32" Padding="0,5,0,0" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}"
            Classes="bar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource tool.reset}" Command="{Binding ResetCommand}" Focusable="False" />
          <Button Content="{DynamicResource tool.cancel}" Command="{Binding CancelCommand}" ToolTip.Tip="Esc" />
          <!-- The picture shown, edited, onto the clipboard instead of a file; the window then closes (ImageToolSettings.CloseAfterCopy). -->
          <Button Content="{Binding CopyText}" Command="{Binding CopyCommand}" ToolTip.Tip="Ctrl+C" />
          <Button Classes="accent" Content="{DynamicResource tool.save}" Command="{Binding SaveCommand}" ToolTip.Tip="Enter" />
        </StackPanel>
        <TextBlock Classes="caption" Text="{Binding FooterText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <!-- The tool's own settings; its width is ImageToolWindow.PanelWidth. On a short window it scrolls: the bars above and
         below keep their room (they are docked first), and the picture takes what is left. -->
    <Border DockPanel.Dock="Right" Width="260" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}"
            Classes="bar">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="ToolPanel" Margin="18,16" />
      </ScrollViewer>
    </Border>

    <!-- The tool's picture view (the crop box, say): ImageToolWindow puts it in. Until the picture is there, a line on top of
         it says it is being read, or that it can't be shown, so a big or damaged file does not look like a broken window. -->
    <Panel>
      <Border x:Name="PictureHost" />
      <TextBlock Classes="caption" Text="{Binding PreviewStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" />
    </Panel>
  </DockPanel>
</Window>
