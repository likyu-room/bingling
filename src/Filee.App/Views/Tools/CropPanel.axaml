<!-- The crop tool's side of the image tool window: the ratio chips and the box's size in pixels of the file shown. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels"
             x:Class="Filee.App.Views.Tools.CropPanel"
             x:DataType="vm:ImageToolViewModel">
  <UserControl.Styles>
    <!-- Chips that don't take the focus: ← / → keep moving between files, and 1 to 7 pick a ratio. -->
    <Style Selector="ListBox.chips">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="18">
    <StackPanel>
      <TextBlock Classes="label" Text="{DynamicResource tool.crop.aspect}" />
      <ListBox Classes="chips" ItemsSource="{Binding Aspects}" SelectedItem="{Binding Aspect}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="label" Text="{DynamicResource tool.crop.size}" />
      <!-- Taken when the box loses the focus (or on Enter, see ImageToolWindow): one undo step per number. -->
      <Grid ColumnDefinitions="*,Auto,*">
        <TextBox Text="{Binding PixelWidth, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="muted" Text="×" Margin="8,0" VerticalAlignment="Center" />
        <TextBox Grid.Column="2" Text="{Binding PixelHeight, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
