<!-- The crop tool's side of the image tool window: the ratio chips and the box's size in pixels of the file shown. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels"
             xmlns:tools="using:Filee.App.ViewModels.Tools"
             x:Class="Filee.App.Views.Tools.CropPanel"
             x:DataType="tools:CropToolViewModel">
  <StackPanel Spacing="18">
    <StackPanel>
      <TextBlock Classes="label" Text="{DynamicResource tool.crop.aspect}" />
      <ListBox Classes="chips" ItemsSource="{Binding Aspects}" SelectedItem="{Binding Aspect}"
               ToolTip.Tip="{DynamicResource tool.crop.keys}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="label" Text="{DynamicResource tool.crop.size}" />
      <!-- Taken when the box loses the focus (or on Enter, see ImageToolWindow): one undo step per number. -->
      <Grid ColumnDefinitions="*,Auto,*">
        <TextBox Text="{Binding PixelWidth, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="muted" Text="×" Margin="8,0" VerticalAlignment="Center" />
        <TextBox Grid.Column="2" Text="{Binding PixelHeight, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
