<!-- The redact tool's side of the image tool window: the way of hiding (a black box, a mosaic or a blur), how many boxes there are,
     what to do on the picture, the button that deletes the picked box, "find what to hide" with what it found, and the note
     that the result carries no photo info. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels"
             xmlns:tools="using:Filee.App.ViewModels.Tools"
             x:Class="Filee.App.Views.Tools.RedactPanel"
             x:DataType="tools:RedactToolViewModel">
  <StackPanel Spacing="18">
    <StackPanel>
      <TextBlock Classes="label" Text="{DynamicResource tool.redact.mode}" />
      <ListBox x:Name="ModeChips" Classes="chips" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
               ToolTip.Tip="{DynamicResource tool.redact.keys}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock FontWeight="SemiBold" Text="{Binding BoxCountText}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource tool.redact.hint}" />
    </StackPanel>

    <!-- Always there, on while a box is picked: the Delete key was the only way, and nothing said so. -->
    <Button x:Name="DeleteButton" HorizontalAlignment="Left" Padding="10,5" Focusable="False" Command="{Binding DeleteSelectionCommand}"
            ToolTip.Tip="Delete">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Delete}" />
        <TextBlock Text="{DynamicResource tool.delete_selected}" />
      </StackPanel>
    </Button>

    <!-- Find what to hide: on for one file only, and its tip says why when it is off. What was found is listed, each one
         chosen at first and outlined on the picture in its kind's colour; "Hide selected" makes boxes of them. It sits above
         the list, which scrolls on its own, so a long list never pushes it out of sight. -->
    <StackPanel Spacing="8">
      <Button x:Name="FindButton" HorizontalAlignment="Left" Padding="10,5" Focusable="False" Command="{Binding FindCommand}"
              ToolTip.Tip="{Binding FindTip}" ToolTip.ShowOnDisabled="True">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Search}" />
          <TextBlock Text="{DynamicResource tool.redact.find}" />
        </StackPanel>
      </Button>
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding FindStatus}"
                 IsVisible="{Binding FindStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Button x:Name="HideChosenButton" HorizontalAlignment="Left" Padding="10,5" Focusable="False" Command="{Binding HideChosenCommand}"
              IsVisible="{Binding HasSpots}" Content="{DynamicResource tool.redact.hide_chosen}" />
      <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSpots}">
        <ItemsControl ItemsSource="{Binding Spots}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tools:FoundSpot">
              <CheckBox Focusable="False" IsChecked="{Binding IsChosen}" AutomationProperties.Name="{Binding AccessibleName}">
                <DockPanel>
                  <Border DockPanel.Dock="Left" CornerRadius="999" Padding="7,1" Margin="0,0,6,0" VerticalAlignment="Center"
                          Background="{Binding KindBrush}">
                    <TextBlock Text="{Binding KindText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>

    <!-- Always there, set apart as the last word of the panel: the saved picture never keeps the photo's own info, which
         can hold what was hidden. -->
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}" Padding="0,12,0,0">
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource tool.redact.metadata_note}" />
    </Border>
  </StackPanel>
</UserControl>
