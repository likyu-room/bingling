<!--
  The instant eyedropper (ScreenTools.StartColorPick): covers the screen the cursor is on with a window that is all but
  invisible (#01000000 still takes the clicks), so the screen shows as it is and only the magnifier beside the cursor is
  new. A left click picks the colour under it; Esc or a right click closes it.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Filee.App.Controls"
        x:Class="Filee.App.Views.PickColorWindow"
        Title="{DynamicResource tray.pick_color}"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        Cursor="Cross">
  <Canvas Background="#01000000">
    <c:Magnifier x:Name="Lens" />
  </Canvas>
</Window>
